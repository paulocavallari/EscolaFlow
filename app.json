{
  "expo": {
    "name": "Ocorrências VC",
    "slug": "EscolaFlow",
    "version": "1.0.0",
    "scheme": "escolaflow",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.escolaflow.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "O Ocorrências VC precisa da sua permissão para converter sua fala em texto.",
        "NSMicrophoneUsageDescription": "O Ocorrências VC precisa do microfone para ouvir a ocorrência e transcrever."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.escolaflow.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-speech-recognition",
        {
          "speechRecognitionPermission": "O Ocorrências VC precisa da sua permissão para converter sua fala em texto.",
          "microphonePermission": "O Ocorrências VC precisa do microfone para ouvir a ocorrência e transcrever."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2ef76138-2aeb-45fe-af38-71b1cd6f007c"
      }
    },
    "owner": "paulocavallari"
  }
}
